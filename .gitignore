# ═══════════════════════════════════════════════════════════════════════════
# ROBOCON 2027 BR 感知系统 — 忽略规则
# ═══════════════════════════════════════════════════════════════════════════

# ── ROS 2 / colcon 构建产物 (本仓库是"仓库根 = ROS 包", 构建目录就在根下) ──
build/
install/
log/

# ── Python ──
__pycache__/
*.py[cod]

# ── IDE ──
.idea/
*.iml
.vscode/

# ── 本机工具配置 (名字里就写着 local) ──
.claude/settings.local.json

# ── 生成的仿真资产 ──
#   gazebo/ 下的世界与模型定义 (约 35KB) **纳管** —— VM/CI 拉下来即可直接用,
#   不必先跑生成器 (重新生成: python3 scripts/make_gazebo_world.py)
scripts/out/*
!scripts/out/gazebo/
#   26MB 的 rc1_field_zup.stl 是旧 spec 的存档, 当前世界已不用它
#   (make_gazebo_world.py 的 README 自述) → 两份副本共 53MB, 不入库
scripts/out/gazebo/rc1_field_zup.stl
scripts/out/gazebo/models/br_field/meshes/rc1_field_zup.stl

# ── 测试数据 (ros2 bag 体积大, 不入库; 录法见 doc/容器化重构_任务清单) ──
test/test_data/

# ── 系统杂物 ──
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ── 规则书原件 (主办方材料, public 仓库不宜转载; 要纳管就删掉下面两行) ──
doc/Robocon_2027_Rulebook_v1.0 _CN.pdf
scripts/_rb11.pdf

# ── 规则书提取文本 (与上面的 PDF 同理: 主办方材料, public 仓库不宜转载) ──
scripts/_rb*.txt
scripts/_rulebook*.txt
.tmp_pdf/_rulebook*.txt

# ── 代码目录里的散图 (图统一放 doc/) ──
src/**/*.svg
