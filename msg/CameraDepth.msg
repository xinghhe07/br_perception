# CameraDepth.msg — D435i 深度辅助（任务书 §3.0 三相机并行）
#
# 角色：**只出深度，不跑 YOLO**。本节点是"给我一个 ROI，我告诉你那里的**鲁棒深度**"。
#
# ⚠️ 三条设计决定（2026-09-20 二版，按评审改）
#   ① **不用"最小深度"** —— 最小值会被噪声点 / 边缘飞点 / 反光 / 目标外的近处物体劫持。
#      改用「**最近的显著深度簇**」（要求成簇像素数达标）的**中值**与**质心**。
#   ② **两种模式** —— 巡航时不做任何逐像素工作（只低频健康检查）；
#      只有收到目标 ROI 才进入 MEASURE。
#   ③ **塔高交叉验证已拆出** —— 那是另一个职责，归 building_height_verifier（标定后）。
#      本消息不再带 spot_heights_*。
#
# ⚠️ 本消息**刻意不阻塞主感知链** —— 它迟到或丢失，主链（两路 YOLO）不受影响。

std_msgs/Header header
# ⚠️ 时间戳 = **曝光时刻**，继承自输入深度图，禁止用 now()（任务书 §四 时间戳约定）

# ── 流健康（两种模式下都填）──
bool    valid                   # 深度流健康（有效像素占比达阈）
float32 valid_ratio             # 有效深度像素占 ROI 的比例 [0,1]

# ── 模式 ──
uint8 MODE_IDLE    = 0          # 巡航：未收到目标 ROI，下面的深度统计字段无意义
uint8 MODE_MEASURE = 1          # 动作：正在对目标 ROI 出鲁棒深度
uint8 mode

# ── 鲁棒深度统计（仅 MODE_MEASURE 有效）──
#   统计对象是「**最近的显著簇**」——从近到远扫深度直方图，第一个像素数达标的 bin 区间。
#   这样单个飞点/反光不会劫持结果（成簇要求把它挡掉了）。
float32 target_depth_m          # ⭐ **主用值**：该簇的**中值**深度 (m)
float32 target_depth_p25_m            # 该簇的 25 分位
float32 target_depth_p75_m            # 该簇的 75 分位
float32 target_depth_std_m            # 该簇深度的**一致性** —— ⚠️ 不是"平整度"!
                                      #   std 大可能是: 斜面 / 球体曲面 / 多物体混合 /
                                      #   深度边缘 / 噪声 / ROI 含背景。别当"表面必须平"用。
uint32  target_pixel_count      # 该簇的像素数（下游据此判断样本够不够）

# ── 目标在图中的位置（**原图像素坐标** vs 质心）──
#   用**质心**而不是 ROI 中心：目标未必填满 ROI，中心可能落在背景上。
float32 target_u
float32 target_v

# ── 可信度 ──
#   由 valid_ratio、簇内像素数、簇内 std 三者导出 [0,1]。
#   下游动作控制应据此决定"这个深度能不能用"。
float32 confidence
