<?xml version="1.0"?>
<!--
  fishbot — BR 感知仿真载具 (顶替尚未完工的实车)

  车体取自 chapt7_ws/src/fishbot_description (差速双轮 + 前后万向轮),
  由 xacro + `gz sdf -p` 转换后手工整理。传感器按被删的 sensor_rig
  (见 git 8e3383d^) 的仿真契约重新配置, 话题/frame 名对齐
  config/fusion_params.yaml 与 launch/bringup_gazebo.launch.py。

  ⚠ 与实机差异 (实车到位后要改回):
     - 雷达是 16 线 ray 传感器 (±0.26 rad), 不是 Mid-360 的 -7°~+52°
     - 相机内参见 config/camera_params.yaml, 那里按 1280×720 标定,
       这里渲染 640×384 (沿用 sensor_rig, VM 上软渲染带不动更高分辨率)
     - 驱动换了差速插件, 不再走 ros2_control (省掉 controller spawner)

  frame 约定 (fusion_params.yaml §static_tf):
     base_link ← livox_frame / camera_wide_frame / camera_tele_frame
  这三段固定变换与此文件里的 <pose> 必须一致, 由 launch 的
  static_transform_publisher 广播 (Gazebo 不给固定关节发 TF)。
-->
<sdf version="1.7">
  <model name="fishbot">
    <static>false</static>

    <!-- ═══ 车体 (含所有固定传感器) ═══ -->
    <link name="base_link">
      <inertial>
        <pose>0.007143 0 0.106829 0 0 0</pose>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.00737458</ixx>
          <ixy>0</ixy>
          <ixz>-0.000600714</ixz>
          <iyy>0.00894315</iyy>
          <iyz>0</iyz>
          <izz>0.00661131</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0.0919 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.1</radius></cylinder></geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.0919 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.1</radius></cylinder></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>

      <!-- 前后万向轮 (无摩擦球, 只起支撑) -->
      <collision name="front_caster_collision">
        <pose>0.08 0 0.0159 0 0 0</pose>
        <geometry><sphere><radius>0.016</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>1e+09</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="front_caster_visual">
        <pose>0.08 0 0.0159 0 0 0</pose>
        <geometry><sphere><radius>0.016</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="back_caster_collision">
        <pose>-0.08 0 0.0159 0 0 0</pose>
        <geometry><sphere><radius>0.016</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>1e+09</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="back_caster_visual">
        <pose>-0.08 0 0.0159 0 0 0</pose>
        <geometry><sphere><radius>0.016</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>

      <!-- 雷达支撑杆 + 雷达外壳 (纯装饰, 位置对应 livox_frame) -->
      <visual name="lidar_mast_visual">
        <pose>0 0 0.1919 0 0 0</pose>
        <geometry><cylinder><length>0.1</length><radius>0.01</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="lidar_head_visual">
        <pose>0 0 0.2419 0 0 0</pose>
        <geometry><cylinder><length>0.02</length><radius>0.02</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- 两路工业相机 + IMU 的外壳 (尺寸/位置对应下面各 <sensor> 的 <pose>) -->
      <visual name="camera_wide_visual">
        <pose>0.1 0 0.1669 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material><ambient>0.1 0.25 0.7 1</ambient><diffuse>0.1 0.25 0.7 1</diffuse></material>
      </visual>
      <visual name="camera_tele_visual">
        <pose>0.1 0 0.1669 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material><ambient>0.7 0.25 0.1 1</ambient><diffuse>0.7 0.25 0.1 1</diffuse></material>
      </visual>
      <visual name="camera_depth_visual">
        <pose>0.105 0 0.125 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material><ambient>0.55 0.1 0.65 1</ambient><diffuse>0.55 0.1 0.65 1</diffuse></material>
      </visual>
      <visual name="imu_visual">
        <pose>0 0 0.1119 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material>
      </visual>

      <!-- ─── 雷达: 16 线 ray → PointCloud2 ───
           参数照搬 sensor_rig: 水平 360 / 垂直 16 / ±0.26 rad / 0.05~15.0m
           桥接节点 pointcloud2_to_livox_custom 的 elev ±14.9° = 0.26 rad 与此对应 -->
      <sensor name="livox" type="ray">
        <pose>0 0 0.2419 0 0 0</pose>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1416</min_angle>
              <max_angle>3.1416</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>15.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/livox/lidar/pointcloud</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>

      <!-- ─── IMU → /imu/data ─── -->
      <sensor name="imu_s" type="imu">
        <pose>0 0 0.1119 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/imu/data</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>

      <!-- ─── 宽角相机 → /camera_wide/image_raw ───
           ⚠️ 2026-09-23 改名: 原名 `cam_front`(前相机)。改名的理由见下一条 -->
      <sensor name="cam_wide_s" type="camera">
        <pose>0.1 0 0.1669 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.1</horizontal_fov>
          <image><width>640</width><height>384</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <plugin name="gazebo_ros_camera_cam_wide" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/image_raw:=/camera_wide/image_raw</remapping>
          </ros>
          <camera_name>camera_wide</camera_name>
          <frame_name>camera_wide_frame</frame_name>
        </plugin>
      </sensor>

      <!-- ─── 深度相机 (任务书: Intel RealSense 435i, 近距深度) ───
           挂在宽角相机下方。出三路: /camera_depth/image_raw (RGB),
           /camera_depth/depth/image_raw (32FC1), /camera_depth/points (PointCloud2)。
           ⚠ 话题名任务书没定 (全文没有 RealSense 话题约定), 这里按现有
             /camera_<角色>/... 的模式起名; 代码目前也还没有深度订阅者。 -->
      <sensor name="cam_depth_s" type="depth">
        <pose>0.105 0 0.125 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>640</width><height>384</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
        <plugin name="gazebo_ros_camera_cam_depth" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>camera_depth</camera_name>
          <frame_name>camera_depth_frame</frame_name>
        </plugin>
      </sensor>

      <!-- ─── 长焦相机 → /camera_tele/image_raw ───
           ⚠️⚠️ 2026-09-23 **这是一次语义修正，不只是改名**。原名 `cam_rear`(后相机)，
              当时建的是「车尾、绕 z 转 180°、hfov 1.1」—— 而实机是
              **JR H200S 一宽一长焦、两路都朝前**（任务书 §0 传感器行）。
              所以三处一起改（改名的理由：位置名会撒谎，光学名不会）：
                · 名字   cam_rear → cam_tele        （+ topic / frame_name 同步）
                · 朝向   yaw 3.1416 → 0             （**都朝 +x**）
                · 视场   hfov 1.1 → 0.40            （**长焦**；1.1 与宽角一模一样是错的）
              基准取自 `scripts/make_gazebo_world.py:180-181`（sensor_rig 那套已按
              同一决定改过：cam_wide 1.10 / cam_tele 0.40，都朝 +x）。
           ⚠️ **安装位置是占位**：实机两路相机的真实间距/高度（`camera_hardware.yaml`
              的 `translation`）**尚未标定**，这里让两台仿真相机**共用同一个挂点** ——
              刻意不编一个假的偏移，免得将来标定完还要回来同步两处假数据。
              标定落地后，**本处 pose 与 launch 里的静态 TF 要一起改**。 -->
      <sensor name="cam_tele_s" type="camera">
        <pose>0.1 0 0.1669 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>0.40</horizontal_fov>
          <image><width>640</width><height>384</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <plugin name="gazebo_ros_camera_cam_tele" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/image_raw:=/camera_tele/image_raw</remapping>
          </ros>
          <camera_name>camera_tele</camera_name>
          <frame_name>camera_tele_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ═══ 驱动轮 ═══ -->
    <link name="left_wheel_link">
      <!-- ⚠ 必须显式声明相对关节的 pose: 缺了它 link 会落回模型原点,
           轮子位置塌进车体, 物理直接崩 (车会自己漂+歪 18°) -->
      <pose relative_to="left_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.94667e-05</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.94667e-05</iyy>
          <iyz>0</iyz>
          <izz>2.56e-05</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.57079 0 0</pose>
        <geometry><cylinder><length>0.04</length><radius>0.032</radius></cylinder></geometry>
        <surface>
          <contact><ode><kp>1e+09</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>20</mu><mu2>20</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.57079 0 0</pose>
        <geometry><cylinder><length>0.04</length><radius>0.032</radius></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose relative_to="right_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.94667e-05</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.94667e-05</iyy>
          <iyz>0</iyz>
          <izz>2.56e-05</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.57079 0 0</pose>
        <geometry><cylinder><length>0.04</length><radius>0.032</radius></cylinder></geometry>
        <surface>
          <contact><ode><kp>1e+09</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>20</mu><mu2>20</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <pose>0 0 0 1.57079 0 0</pose>
        <geometry><cylinder><length>0.04</length><radius>0.032</radius></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 0.1 0.0319 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 -0.1 0.0319 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- ═══ 差速驱动 ═══
         话题与 sensor_rig 时代的 planar_move 保持一致: /cmd_vel 进, /odom 出。
         robot_base_frame=base_link 与 fusion_params.yaml 的 robot_base_frame 对齐。 -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.2</wheel_separation>
      <wheel_diameter>0.064</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
